<?xml version="1.0" encoding="UTF-8"?>
<configuration>

  <!-- ─── Dev profile: legible en consola ───────────────────────────────── -->
  <springProfile name="dev,default">
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
      <encoder>
        <pattern>%d{HH:mm:ss.SSS} %highlight(%-5level) [%cyan(%15.15t)] %yellow(%-40.40logger{39}) : %msg%n</pattern>
      </encoder>
    </appender>

    <root level="INFO">
      <appender-ref ref="CONSOLE"/>
    </root>

    <logger name="com.tunegocio" level="DEBUG"/>
    <logger name="org.springframework.web" level="WARN"/>
    <logger name="org.hibernate.SQL" level="WARN"/>
  </springProfile>

  <!-- ─── Prod profile: JSON estructurado para ELK / Datadog ──────────── -->
  <springProfile name="prod">
    <appender name="JSON" class="ch.qos.logback.core.ConsoleAppender">
      <encoder class="net.logstash.logback.encoder.LogstashEncoder">
        <customFields>{"app":"tunegocio-api","env":"prod"}</customFields>
        <fieldNames>
          <timestamp>@timestamp</timestamp>
          <version>[ignore]</version>
        </fieldNames>
      </encoder>
    </appender>

    <root level="INFO">
      <appender-ref ref="JSON"/>
    </root>

    <logger name="com.tunegocio" level="INFO"/>
    <logger name="org.springframework.web" level="WARN"/>
  </springProfile>

</configuration>
